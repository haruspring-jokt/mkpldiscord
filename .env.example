# Discord ボットトークン（Discord Developer Portal で発行）
DISCORD_TOKEN=
# 対象 Discord サーバー（ギルド）の ID
DISCORD_GUILD_ID=

# Google サービスアカウントキー JSON ファイルへのパス
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Div1 管理用スプレッドシート ID
SPREADSHEET_DIV1_ID=
# Div2 管理用スプレッドシート ID
SPREADSHEET_DIV2_ID=
# 共通スプレッドシート ID（場所調整など）
SPREADSHEET_SHARED_ID=
# Google カレンダー ID
CALENDAR_ID=
# Google Cloud Storage のバケット名
GCS_BUCKET_NAME=
# GCS 内の topics JSON オブジェクト名
TOPICS_JSON_OBJECT=

# 運営ロールの Discord ロール ID（@運営 判定に使用）
ADMIN_ROLE_ID=
# bot-logチャンネルID
BOT_LOG_CHANNEL_ID=

# メッセージ送信を行わずログ出力のみ行うモード（1=true, 0=false）
REMINDER_DRY_RUN=0
# 毎月1日試合チャンネル作成バッチの動作有無（1=true, 0=false）
GAME_CHANNEL_CREATE_BATCH_ENABLED=1
# 毎月1日試合チャンネル作成バッチの動作時刻（ddhhmm 形式、例: 010900）
GAME_CHANNEL_CREATE_BATCH_TIME=010900
# 10日リマインダーの動作有無（1=true, 0=false）
REMINDER_10_ENABLED=1
# 10日リマインダーの動作時刻（ddhhmm 形式、例: 100900）
REMINDER_10_SCHEDULE=100900
# 20日リマインダーの動作有無（1=true, 0=false）
REMINDER_20_ENABLED=1
# 20日リマインダーの動作時刻（ddhhmm 形式、例: 200900）
REMINDER_20_SCHEDULE=200900
# 25日リマインダーの動作有無（1=true, 0=false）
REMINDER_25_ENABLED=1
# 25日リマインダーの動作時刻（ddhhmm 形式、例: 250900）
REMINDER_25_SCHEDULE=250900
# 日次バッチの動作有無（1=true, 0=false）
DAILY_BATCH_ENABLED=0
# 日次バッチの動作時刻（HHMM 形式、例: 0700）
DAILY_BATCH_TIME=0700

# 試合日程確定モーダル関連
# Div1 試合結果報告フォーム URL
MATCH_RESULT_FORM_URL_DIV1=
# Div2 試合結果報告フォーム URL
MATCH_RESULT_FORM_URL_DIV2=
# Div1 日程ページ URL
SCHEDULE_PAGE_URL_DIV1=https://molkkyprime.com/schedule/#yksi-matches-top
# Div2 日程ページ URL
SCHEDULE_PAGE_URL_DIV2=https://www.molkkyprime.com/schedule/#kaksi-matches-top
# 共通調整シート URL
SHARED_SHEET_URL=
# 試合詳細ページのベース URL（末尾に試合IDを連結）
MATCH_SITE_BASE_URL=https://molkkyprime.com/match?gid=

# リーグ固有情報
# リーグ表示名（完了メッセージやイベント名で使用）
LEAGUE_LABEL_DIV1=ユクシ
# リーグ表示名（完了メッセージやイベント名で使用）
LEAGUE_LABEL_DIV2=チャレンジ
# Div1 のカレンダーイベント名プレフィックス
LEAGUE_EVENT_PREFIX_DIV1=MKPL
# Div2 のカレンダーイベント名プレフィックス
LEAGUE_EVENT_PREFIX_DIV2=MKPLC
# 現シーズン
LEAGUE_CURRENT_SEASON=2026-27
# 現シーズンの最初の月（yymm)
LEAGUE_CURRENT_SEASON_FIRST_MONTH=2609
# 現シーズンの最後の月（yymm)
LEAGUE_CURRENT_SEASON_LAST_MONTH=2703
# 有効試合チャンネルが含まれるDiscordサーバーのカテゴリーID（ユクシ）
DISCORD_CATEGORY_ID_DIV1=
# 有効試合チャンネルが含まれるDiscordサーバーのカテゴリーID（チャレンジ）
DISCORD_CATEGORY_ID_DIV2=
# 申請フォーラムID（ユクシ）
DISCORD_APPLY_FORUM_ID_DIV1=
# 申請フォーラムID（チャレンジ）
DISCORD_APPLY_FORUM_ID_DIV2=

# Google Calendar API の colorId（イベント色指定）
CALENDAR_COLOR_ID_DIV1=1
# Google Calendar API の colorId（イベント色指定）
CALENDAR_COLOR_ID_DIV2=2
# 参考用 hex（API には使用しない）
CALENDAR_COLOR_HEX_DIV1=b39ddb
# 参考用 hex（API には使用しない）
CALENDAR_COLOR_HEX_DIV2=33b679
